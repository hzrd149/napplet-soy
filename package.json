{
  "name": "napplet-space",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts development",
    "demo:minicraft": "bun scripts/minicraft.ts",
    "test:minicraft": "bun test tests/services/minicraft-browser.test.ts",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "typecheck": "tsc --noEmit",
    "test": "bun test packages apps/cli scripts",
    "test:browser": "bunx playwright test",
    "check": "bun run typecheck && bun run test",
    "check:nix": "bash scripts/nix-check.sh",
    "update:nix-hashes": "bash scripts/nix-update-hashes.sh",
    "fixtures": "bun scripts/seed.ts",
    "napplet": "bun apps/cli/src/index.ts",
    "soyli": "bun apps/cli/src/index.ts",
    "cli:build": "bun scripts/cli-build.ts",
    "cli:release": "bun scripts/cli-release.ts",
    "cvm": "bun apps/cvm/src/index.ts",
    "test:backend": "bun test packages/multiplayer apps/cli/src/backend.test.ts tests/services/backend-relay.test.ts",
    "test:backend:browser": "bun test tests/services/backend-browser.test.ts tests/services/backend-account-browser.test.ts",
    "deploy": "bun scripts/deploy.ts",
    "dev:setup": "bun scripts/dev.ts setup",
    "dev:doctor": "bun scripts/dev.ts doctor",
    "dev:down": "bun scripts/dev.ts down",
    "dev:prod": "bun scripts/dev.ts production",
    "relay:build": "bun scripts/relay.ts build",
    "relay:seed": "bun scripts/relay.ts seed",
    "blossom:build": "bun scripts/blossom.ts build",
    "blossom:seed": "bun scripts/blossom.ts seed",
    "test:relay": "bun scripts/relay-go.ts test -race ./... && bun test tests/services/relay.test.ts tests/services/relay-runner.test.ts",
    "test:blossom": "bun test tests/services/blossom*.test.ts",
    "grasp:build": "bun scripts/grasp-build.ts",
    "grasp:seed": "bun scripts/grasp.ts",
    "test:grasp": "bun test tests/services/grasp.test.ts",
    "test:identity": "bun test packages/identity apps/cli/src/accounts.test.ts tests/services/creator.test.ts",
    "test:identity:native": "SPACE_TEST_NATIVE_KEYSTORE=1 bun test tests/services/native-identity.test.ts",
    "test:publish": "bun test packages/publish tests/services/publish*.test.ts",
    "test:publish:native": "SPACE_TEST_NATIVE_KEYSTORE=1 bun test tests/services/publish*.test.ts",
    "test:index": "bun run build && bun test tests/services/index.test.ts",
    "walkthrough:render": "bun scripts/render-walkthrough.ts",
    "presentation:render": "bun scripts/presentation/render.ts",
    "presentation:preview": "bun scripts/presentation/serve.ts",
    "presentation:spatial": "bun scripts/presentation/spatial/serve.ts",
    "presentation:spatial:render": "bun scripts/presentation/spatial/render.ts",
    "mascot:align": "bun scripts/sprite-align/serve.ts"
  },
  "dependencies": {
    "@contextvm/sdk": "0.13.16",
    "@fontsource/dm-mono": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.31.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napplet/shim": "0.30.0",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@resvg/resvg-js": "2.6.2",
    "@scure/base": "2.4.0",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "applesauce-accounts": "6.2.0",
    "applesauce-core": "6.2.0",
    "applesauce-react": "6.0.0",
    "applesauce-relay": "6.2.1",
    "applesauce-signers": "6.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "entities": "7.0.0",
    "highlight.js": "11.11.1",
    "ipaddr.js": "2.5.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.45.0",
    "nostr-tools": "2.25.2",
    "nostr-wasm": "0.1.0",
    "qrcode": "1.5.4",
    "quickjs-emscripten": "0.31.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@remotion/bundler": "4.0.524",
    "@remotion/renderer": "4.0.524",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "node-addon-api": "8.9.2",
    "node-gyp": "12.4.0",
    "playwright-core-mac-compat": "npm:playwright-core@1.61.1",
    "pm2": "7.0.4",
    "prettier": "3.9.6",
    "remotion": "4.0.524",
    "tailwindcss": "4.3.3",
    "three": "0.186.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
